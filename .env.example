# Copy to .env.local for local development; set the same names in Vercel.

# --- Option A: your own Blackthorn client (local development) ---
# OpenAI-compatible URL of a running `blackthorn serve`. If neither this nor
# BLACKTHORN_TOKEN is set, http://127.0.0.1:8000/v1 is used.
BLACKTHORN_BASE_URL=

# --- Option B: bundled client (hosted deployments, e.g. Vercel) ---
# Your Blackthorn API key. The build downloads the Linux client and the server
# runs it with this token. Never commit this value.
BLACKTHORN_TOKEN=

# Optional: the Blackthorn host the key belongs to (the client has a default).
BLACKTHORN_HOST=

# Optional (option A): bearer token, if your client sits behind an authenticating proxy.
BLACKTHORN_API_KEY=

# Optional: model id. Defaults to the first model the client lists.
BLACKTHORN_MODEL=

# --- Web search (optional) ---
# Set one key to let the model search the web. Search queries go to that
# provider in plaintext, outside Blackthorn's encryption.
# Tavily: free plan, no credit card (https://tavily.com).
TAVILY_API_KEY=
# Brave Search: metered, credit card required (https://brave.com/search/api).
# Used instead of Tavily when set.
BRAVE_API_KEY=

# Shared password visitors must enter. Required in production; leave empty
# locally to skip the gate.
APP_PASSWORD=

# Optional: extra instructions appended to the built-in system prompt.
SYSTEM_PROMPT=
