# Copy to .env.local for local development; set the same names in Vercel.

# OpenAI-compatible URL of a running Blackthorn client (`blackthorn serve`).
BLACKTHORN_BASE_URL=http://127.0.0.1:8000/v1

# Optional: bearer token, only if the client sits behind an authenticating proxy.
BLACKTHORN_API_KEY=

# Optional: model id. Defaults to the first model the client lists.
BLACKTHORN_MODEL=

# Shared password visitors must enter. Required in production; leave empty
# locally to skip the gate.
APP_PASSWORD=

# Optional: system prompt prepended to every conversation.
SYSTEM_PROMPT=
